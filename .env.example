# Copy to .env.local (gitignored) and fill in. Never commit real keys: the repository is public.
#
# Local: run `pnpm db:start`, then `pnpm exec supabase status` prints the values below
#   (API URL, anon key, service_role key).
# Staging / production: Supabase dashboard → Project Settings → API, for abt-staging or abt-prod.
#   On Vercel, set them as environment variables instead.

# Public: inlined into the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only: bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
